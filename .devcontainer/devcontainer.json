{
  "name": "Bridge Dev",
  "image": "mcr.microsoft.com/devcontainers/node:22",
  "features": {},
  "postCreateCommand": "npm ci && npm run build",
  "postStartCommand": "npm run start",
  "forwardPorts": [2000],
  "portsAttributes": {
    "2000": {
      "label": "Bridge Server",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode"
      ]
    }
  }
}
